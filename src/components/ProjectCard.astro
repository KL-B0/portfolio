---
import { Icon } from "astro-icon/components";

export interface Props {
  href: string;
  title: string;
  description: string;
  tags?: string[];
  date: Date;
}

const { href, title, description, tags, date } = Astro.props;
---

<a href={href}>
  <div class="project-container">
    <div class="title-container">
      <h3>{title}</h3>
    </div>
    <p>{description}</p>
    <div class="flex flex-col items-center gap-3">
      <div class="tags-container">
        <ul>
          {tags?.map(tag => <li>{tag}</li>)}
        </ul>
      </div>
      <div class="info-container">
        <Icon class="w-5  sm:w-8" name="lucide:calendar-days" />
        <p>{date.getFullYear()}</p>
      </div>
    </div>
  </div>
</a>

<style>
  @reference "tailwindcss";

  .project-container {
    @apply flex h-fit max-w-screen-xl flex-col gap-3 rounded-xl  p-4 shadow-xl;
  }
  .title-container {
    @apply flex flex-row justify-center;
  }
  .project-container h3 {
    @apply m-1 text-xl font-bold  underline underline-offset-4 duration-75 sm:text-2xl;
  }
  .project-container p {
    @apply text-base  sm:text-lg;
  }
  .tags-container {
    @apply flex w-full items-center justify-center overflow-x-scroll;
  }
  .tags-container ul {
    @apply flex flex-row items-stretch gap-4 overflow-auto text-sm;
  }
  .tags-container li {
    @apply h-fit w-fit rounded-xl  px-3 py-1 text-sm  sm:text-base;
  }
  .links-container {
    @apply flex flex-row items-center justify-center gap-4;
  }
  img {
    @apply h-20 w-20;
  }

  .info-container {
    @apply flex flex-row items-center gap-2;
  }
  .info-container p {
    @apply  sm:text-lg;
  }
</style>
